# Colosseum — personal access token
# get from: https://colosseum.com/
COLOSSEUM_PERSONAL_ACCESS_TOKEN=

# Pixel Lab — project label/id
PIXEL_LAB=

# Jev / TypeSafe — API key for risk verdicts (red/yellow/green + confidence)
# get from: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Solami — Solana data API key (Pro free 7 days via campaign link)
# get from: https://solami.dev/ dashboard
SOLAMI_API_KEY=

# FlagKan admin key — guards /api/retrain-now and /api/signals-now
# set as worker secret: wrangler secret put ADMIN_KEY (run from radar/)
# local value lives in .env (gitignored) so automation can operate guarded endpoints
ADMIN_KEY=
